{
  "name": "purchase-order-monitor",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10.1.0",
    "eslint": "^10.12.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "node --test",
    "lint": "eslint ."
  },
  "private": true,
  "description": "Bestellüberwachung als Side-by-Side-Erweiterung für SAP S/4HANA (CAP + Fiori Elements)",
  "cds": {
    "i18n": {
      "default_language": "de"
    },
    "requires": {
      "API_PURCHASEORDER_PROCESS_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_PURCHASEORDER_PROCESS_SRV"
      },
      "API_BUSINESS_PARTNER": {
        "kind": "odata-v2",
        "model": "srv/external/API_BUSINESS_PARTNER"
      },
      "[production]": {
        "API_PURCHASEORDER_PROCESS_SRV": {
          "credentials": {
            "destination": "S4HANA",
            "path": "/sap/opu/odata/sap/API_PURCHASEORDER_PROCESS_SRV"
          }
        },
        "API_BUSINESS_PARTNER": {
          "credentials": {
            "destination": "S4HANA",
            "path": "/sap/opu/odata/sap/API_BUSINESS_PARTNER"
          }
        }
      }
    }
  }
}
